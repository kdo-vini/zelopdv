# Copie para `.env` e preencha com os valores do projeto Supabase / integrações.
# Nunca commite o `.env` real.

# --- Supabase (obrigatório para o app local) ---
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Fallbacks aceitos pelo código (equivalentes aos PUBLIC_*):
# VITE_PUBLIC_SUPABASE_URL=
# VITE_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
PUBLIC_APP_URL=http://localhost:5173

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
VITE_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- AbacatePay (Pix) ---
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_PUBLIC_KEY=
ABACATEPAY_BASE_URL=

# --- Email / cron / chat ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPENAI_API_KEY=
CRON_SECRET=
ZELOCHAT_INTERNAL_API_KEY=
ZELOCHAT_INTERNAL_SEND_URL=

# --- iFood worker (opcional) ---
IFOOD_WORKER_ID=
IFOOD_WORKER_HOST=
IFOOD_WORKER_PORT=
PORT=
IFOOD_WORKER_INTERVAL_MS=
IFOOD_WORKER_READY_MAX_AGE_MS=
IFOOD_WORKER_SHUTDOWN_TIMEOUT_MS=
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=

# --- IndexNow (SEO/GEO: notifica Bing/etc a cada deploy de página pública) ---
INDEXNOW_KEY=
