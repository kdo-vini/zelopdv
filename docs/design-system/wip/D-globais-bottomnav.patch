+        return [...rest, { id, tone, ...parts, duration: duration > 0 ? duration : 0 }].slice(-ZELO_TOAST_LIMIT);
+    });
+    return id;
+}
+
+export function dismissZeloToast(id) {
+    zeloToasts.update((list) => list.filter((t) => t.id !== id));
